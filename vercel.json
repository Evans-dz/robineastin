{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/properties",
      "destination": "/#cabins",
      "permanent": true
    },
    {
      "source": "/pine-shadows-orp5b73d5cx",
      "destination": "/cabins/pine-shadows/",
      "permanent": true
    },
    {
      "source": "/wilderness-escape-retreat-orp5b73d5bx",
      "destination": "/cabins/wilderness-escape-retreat/",
      "permanent": true
    },
    {
      "source": "/availability",
      "destination": "/#book",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "/#book",
      "permanent": true
    },
    {
      "source": "/reviews",
      "destination": "/#reviews",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
